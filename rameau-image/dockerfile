ARG VERSION_PYTHON=3.12-slim
FROM python:3.12-slim AS python
ENV USER_ID=root

RUN apt-get update -y \
    && apt-get upgrade -y \
    && apt-get install --yes --only-upgrade openssl libssl3* openssl-provider-legacy \
    && apt-get install libexpat1 -y \
    && apt-get autoremove --purge -y \
    && apt-get clean -y \
    && rm -rf /var/lib/apt/lists/*

USER ${USER_ID}
WORKDIR /app

RUN python -m venv /app/venv
ENV PATH="/app/venv/bin:$PATH"

ENTRYPOINT ["/app/entrypoint.sh"]

FROM python

COPY --chown=${USER_ID}:${USER_ID} src/requirements.txt /app/
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt
COPY --chown=${USER_ID}:${USER_ID} rameau-0.0.8-cp312-cp312-manylinux_2_17_x86_64.manylinux2014_x86_64.whl /tmp/
RUN pip install --no-cache-dir /tmp/rameau-0.0.8-cp312-cp312-manylinux_2_17_x86_64.manylinux2014_x86_64.whl \
    && rm /tmp/rameau-0.0.8-*.whl

COPY --chown=${USER_ID}:${USER_ID} entrypoint.sh /app/entrypoint.sh
COPY --chown=${USER_ID}:${USER_ID} src /app/

RUN chmod +x /app/entrypoint.sh